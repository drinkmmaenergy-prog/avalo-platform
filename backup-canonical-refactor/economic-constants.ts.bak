import { MONETIZATION_SPLITS, SPLITS, getSplit } from '';
/**
 * PACK 267 — Global Economics & Split Rules (Core Constants)
 * 
 * Single source of truth for all Avalo economic rules.
 * NO future module should redefine these constants or splits.
 * 
 * @package avaloapp
 * @version 1.0.0
 */

// ============================================================================
// 1. REVENUE SPLIT CONSTANTS
// ============================================================================

/**
 * Chat monetization split between platform and creator
 * Platform: 35%, Creator: 65%
 */
export const AVALO_SPLIT_CHAT = {
  platform: MONETIZATION_SPLITS.CHAT.avalo,
  creator: MONETIZATION_SPLITS.CHAT.creator,
} as const;

/**
 * Calendar booking split between platform and creator
 * Platform: 20%, Creator: 80%
 */
export const AVALO_SPLIT_CALENDAR = {
  platform: MONETIZATION_SPLITS.EVENT_TICKET.avalo,
  creator: MONETIZATION_SPLITS.EVENT_TICKET.creator,
} as const;

/**
 * Event monetization split between platform and creator
 * Platform: 20%, Creator: 80%
 */
export const AVALO_SPLIT_EVENTS = {
  platform: MONETIZATION_SPLITS.EVENT_TICKET.avalo,
  creator: MONETIZATION_SPLITS.EVENT_TICKET.creator,
} as const;

// ============================================================================
// 2. PAYOUT RATE
// ============================================================================

/**
 * Token to PLN conversion rate for payouts
 * 1 token = MONETIZATION_SPLITS.EVENT_TICKET.avalo PLN
 * This rate is FIXED for payouts and does NOT vary by purchase pack
 */
export const AVALO_PAYOUT_RATE_PLN = MONETIZATION_SPLITS.EVENT_TICKET.avalo;

