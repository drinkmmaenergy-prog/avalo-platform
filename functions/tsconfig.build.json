{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": [
      "node"
    ]
  },
  "exclude": [
    "node_modules",
    "lib",
    "src/__tests__",
    "**/*.test.ts",
    "**/*.spec.ts",
    "src/index.full.ts",
    "**/*.legacy.ts",
    "**/*.legacy.tsx",
    "**/*.legacy.d.ts",
    "**/*.legacy.js",
    "**/*.legacy.ts"
  ]
}
