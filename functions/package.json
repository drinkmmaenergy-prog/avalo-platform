{
  "name": "avalo-cloud-functions",
  "version": "1.0.0",
  "description": "Avalo Phase 5 - Cloud Functions for server-side validation",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "jest --coverage",
    "test:unit": "jest --testPathPattern=tests/unit",
    "test:integration": "jest --testPathPattern=tests/integration --runInBand",
    "test:watch": "jest --watch",
    "test:smoke": "jest --testPathPattern=tests/smoke --runInBand",
    "smoke:functions": "npm run build && jest --testPathPattern=tests/smoke --runInBand --verbose"
  },
  "engines": {
    "node": "20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.72.1",
    "@google-cloud/pubsub": "^5.2.2",
    "@google-cloud/secret-manager": "^5.0.0",
    "@google-cloud/storage": "^7.18.0",
    "@google-cloud/vision": "^5.3.4",
    "@sendgrid/mail": "^8.1.0",
    "@types/express": "^5.0.6",
    "@types/node-fetch": "^2.6.13",
    "@types/uuid": "^11.0.0",
    "axios": "^1.6.0",
    "node-fetch": "^2.7.0",
    "ethers": "^6.16.0",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^4.9.0",
    "qs": "^6.14.1",
    "sharp": "0.33.2",
    "stripe": "^14.25.0",
    "ulid": "^3.0.2",
    "uuid": "^13.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.10.0",
    "@types/qs": "^6.14.0",
    "firebase-functions-test": "^3.1.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.0"
  },
  "private": true
}
