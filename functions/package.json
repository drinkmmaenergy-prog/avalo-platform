{
  "name": "avalo-cloud-functions",
  "version": "1.0.0",
  "description": "Avalo Cloud Functions",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "firebase emulators:exec --only firestore \"jest --coverage --runInBand\""
  },
  "engines": {
    "node": "20"
  },
  "dependencies": {
    "@google-cloud/vision": "^5.3.4",
    "axios": "^1.6.0",
    "ethers": "^6.16.0",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^4.9.0",
    "node-fetch": "^2.7.0",
    "qs": "^6.14.1",
    "sharp": "0.33.2",
    "stripe": "^14.25.0",
    "ulid": "^3.0.2",
    "uuid": "8.3.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.10.0",
    "firebase-functions-test": "^3.1.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "private": true
}
