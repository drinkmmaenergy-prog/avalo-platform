# ========================================================================
# AVALO CLOUD FUNCTIONS — LOCAL ENVIRONMENT VARIABLES
# ========================================================================
#
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.
#
# For Firebase emulator, these values are loaded automatically.
# For production, use Firebase secret manager or functions config.
#
# PHASE 3.1: Stripe Webhook + Treasury Integration
# ========================================================================

# ============================================================================
# STRIPE CONFIGURATION (REQUIRED FOR PAYMENTS)
# ============================================================================

# Stripe Secret Key (https://dashboard.stripe.com/apikeys)
# Test mode: sk_test_...
# Live mode: sk_live_...
STRIPE_SECRET_KEY=sk_test_YOUR_KEY_HERE

# Stripe Webhook Secret (https://dashboard.stripe.com/webhooks)
# Required for webhook signature verification
# Format: whsec_...
STRIPE_WEBHOOK_SECRET=whsec_YOUR_SECRET_HERE

# Stripe API Version (optional, defaults to latest stable)
# STRIPE_API_VERSION=2024-12-18.acacia

# ============================================================================
# STRIPE PRICE IDS (CANONICAL TOKEN PACKS)
# ============================================================================
# Map each token pack to its Stripe Price ID.
# These MUST match prices created in Stripe Dashboard.
# NO coupons, NO discounts, NO promotional pricing.

# STRIPE_PRICE_TOKENPACK_MINI=price_xxx
# STRIPE_PRICE_TOKENPACK_BASIC=price_xxx
# STRIPE_PRICE_TOKENPACK_STANDARD=price_xxx
# STRIPE_PRICE_TOKENPACK_PREMIUM=price_xxx
# STRIPE_PRICE_TOKENPACK_PRO=price_xxx
# STRIPE_PRICE_TOKENPACK_ELITE=price_xxx
# STRIPE_PRICE_TOKENPACK_ROYAL=price_xxx

# ============================================================================
# FIREBASE EMULATOR CONFIGURATION
# ============================================================================

# Set to 'true' when running with Firebase emulators
# FUNCTIONS_EMULATOR=true

# Firestore emulator host (auto-set by Firebase CLI)
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Auth emulator host (auto-set by Firebase CLI)
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# ============================================================================
# APPLICATION URLS
# ============================================================================

# Web application URL (for Stripe checkout success/cancel URLs)
WEB_URL=http://localhost:3000

# Cloud Functions URL (for webhook endpoints)
# Emulator: http://127.0.0.1:5001/PROJECT_ID/REGION
# Production: https://REGION-PROJECT_ID.cloudfunctions.net
FUNCTIONS_URL=http://127.0.0.1:5001/avalo/europe-west3

# ============================================================================
# TREASURY CONFIGURATION
# ============================================================================

# Default currency for settlements (FX0 = always USD canonical)
DEFAULT_CURRENCY=USD

# Platform fee percentage (65% platform / 35% creator)
# PLATFORM_FEE_PERCENT=65

# Minimum payout amounts (in respective currencies)
# MIN_PAYOUT_USD=50
# MIN_PAYOUT_EUR=50
# MIN_PAYOUT_PLN=200

# ============================================================================
# APPLE IN-APP PURCHASE (IF USING IOS)
# ============================================================================

# Apple Shared Secret (App Store Connect → Apps → In-App Purchases)
# APPLE_SHARED_SECRET=your_shared_secret_here

# Set to "true" for sandbox testing, "false" for production
# APPLE_SANDBOX=true

# ============================================================================
# DEVELOPMENT / TESTING
# ============================================================================

# Node environment
NODE_ENV=development

# Test user IDs (for sandbox testing only)
# TEST_USER_ID=test_user_123
# TEST_CREATOR_ID=test_creator_456

# Enable verbose logging
# DEBUG=stripe:*,avalo:*
