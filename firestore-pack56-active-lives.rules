// =============================================================================
// Firestore Security Rules — active_lives collection
// FIX 57D: "Creator went live" real-time alerts
//
// COLLECTION: active_lives/{userId}
//   - Document ID == the hostId (creator's uid)
//   - Read: any authenticated user (followers need to query by hostId 'in' [])
//   - Write: only the document owner (request.auth.uid == userId)
//
// Merge into the main firestore.rules file during deployment.
// =============================================================================

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    match /active_lives/{userId} {
      // Any authenticated user can read (needed for follower live-alert queries)
      allow read: if isAuthenticated();

      // Only the creator themselves can create/update/delete their live entry
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }
  }
}
