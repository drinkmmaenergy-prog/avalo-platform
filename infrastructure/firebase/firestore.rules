rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ──────────────────────────────────────────────
    // Helper functions
    // ──────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasRole(role) {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny([role]);
    }

    function isAdmin() {
      return hasRole('admin') || hasRole('super_admin');
    }

    function isModerator() {
      return hasRole('moderator') || isAdmin();
    }

    // ──────────────────────────────────────────────
    
    // ──────────────────────────────────────────────
    // BLOCK 1B: Public Profiles — discoverable user data
    // ──────────────────────────────────────────────
    match /public_profiles/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }
    // BLOCK 1: Users
    // ──────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();

      // Private user data (settings, preferences)
      match /private/{document=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Wallet subcollection — server-only writes
      match /wallet/{document=**} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if false;
      }
    }

    // ──────────────────────────────────────────────
    // BLOCK 3: Creator Profiles
    // ──────────────────────────────────────────────
    match /creator_profiles/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // ──────────────────────────────────────────────
    // BLOCK 4: Earn Settings (Active Surfaces)
    // ──────────────────────────────────────────────
    match /earn_settings/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // ──────────────────────────────────────────────
    // BLOCK 5: Profiles (legacy — kept for backward compat)
    // ──────────────────────────────────────────────
    match /profiles/{profileId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(profileId);
      allow update: if isOwner(profileId) || isAdmin();
      allow delete: if isAdmin();
    }

    // ──────────────────────────────────────────────
    // BLOCK 6: AI Avatars
    // ──────────────────────────────────────────────
    match /ai_avatars/{avatarId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.creatorId == request.auth.uid;
      allow update, delete: if isAuthenticated() &&
        resource.data.creatorId == request.auth.uid;
    }

    // ──────────────────────────────────────────────
    // BLOCK 7: Posts
    // ──────────────────────────────────────────────
    match /posts/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() &&
        resource.data.authorId == request.auth.uid || isAdmin();
    }

    // ──────────────────────────────────────────────
    // BLOCK 8: Stories
    // ──────────────────────────────────────────────
    match /stories/{storyId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // ──────────────────────────────────────────────
    // BLOCK 9: Reels
    // ──────────────────────────────────────────────
    match /reels/{reelId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // ──────────────────────────────────────────────
    // BLOCK 10: Chats & Messages
    // ──────────────────────────────────────────────
    match /chats/{chatId} {
      allow read: if isAuthenticated() &&
        request.auth.uid in resource.data.participants;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() &&
        request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        allow read: if isAuthenticated() &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if isAuthenticated() &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow update: if isOwner(resource.data.senderId) || isModerator();
        allow delete: if isOwner(resource.data.senderId) || isModerator();
      }
    }

    // ──────────────────────────────────────────────
    // BLOCK 11: Follows
    // ──────────────────────────────────────────────
    match /follows/{followId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.followerId == request.auth.uid;
      allow delete: if isAuthenticated() &&
        resource.data.followerId == request.auth.uid;
    }

    // ──────────────────────────────────────────────
    // BLOCK 12: Likes (content likes — legacy)
    // ──────────────────────────────────────────────
    match /likes/{likeId} {
      allow read: if isAuthenticated() &&
        (resource.data.fromUserId == request.auth.uid ||
         resource.data.toUserId == request.auth.uid ||
         resource.data.userId == request.auth.uid);
      allow write: if false; // Server-only (created by likeUserV1)
    }

    // ──────────────────────────────────────────────
    // BLOCK 13: Tips — server-only writes
    // ──────────────────────────────────────────────
    match /tips/{tipId} {
      allow read: if isAuthenticated() &&
        (resource.data.senderId == request.auth.uid ||
         resource.data.recipientId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // ──────────────────────────────────────────────
    // BLOCK 14: Wallets (top-level) — server-only writes
    // Written by: Stripe webhook (handleCheckoutCompleted)
    // ──────────────────────────────────────────────
    match /wallets/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;
    }

    // ──────────────────────────────────────────────
    // BLOCK 15: Token Purchases — server-only writes
    // ──────────────────────────────────────────────
    match /tokenPurchases/{purchaseId} {
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // ──────────────────────────────────────────────
    // BLOCK 16: Wallet Transactions — server-only writes
    // ──────────────────────────────────────────────
    match /walletTransactions/{txId} {
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // ──────────────────────────────────────────────
    // BLOCK 17: Transactions (legacy) — server-only writes
    // ──────────────────────────────────────────────
    match /transactions/{txId} {
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // ──────────────────────────────────────────────
    // BLOCK 18: Payouts — server-only writes
    // ──────────────────────────────────────────────
    match /payouts/{payoutId} {
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // ──────────────────────────────────────────────
    // BLOCK 19: Creator Balances — server-only writes
    // ──────────────────────────────────────────────
    match /creator_balances/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // ──────────────────────────────────────────────
    // BLOCK 20: Creator Earnings — server-only writes
    // ──────────────────────────────────────────────
    match /creator_earnings/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false;

      match /{document=**} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if false;
      }
    }

    // ──────────────────────────────────────────────
    // BLOCK 21: Earnings Ledger — server-only writes
    // ──────────────────────────────────────────────
    match /earnings_ledger/{entryId} {
      allow read: if isAuthenticated() &&
        isOwner(resource.data.creatorId);
      allow write: if false;
    }

    // ──────────────────────────────────────────────
    // BLOCK 22: Earnings (legacy) — server-only writes
    // ──────────────────────────────────────────────
    match /earnings/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false;
    }

    // ──────────────────────────────────────────────
    // BLOCK 23: Creator Analytics
    // ──────────────────────────────────────────────
    match /creator_analytics/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false;
    }

    match /creator_analytics_daily/{docId} {
      allow read: if isAuthenticated() &&
        isOwner(resource.data.creatorId);
      allow write: if false;

      match /payers/{payerId} {
        allow read, write: if false;
      }
    }

    match /content_analytics_daily/{docId} {
      allow read: if isAuthenticated() &&
        isOwner(resource.data.userId);
      allow write: if false;
    }

    match /creator_analytics_snapshot/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // ──────────────────────────────────────────────
    // BLOCK 24: Treasury & Ledger — FULLY PROTECTED
    // ──────────────────────────────────────────────
    match /treasury/{document=**} {
      allow read, write: if false;
    }

    match /ledger/{document=**} {
      allow read, write: if false;
    }

    // ──────────────────────────────────────────────
    // BLOCK 25: Notifications
    // ──────────────────────────────────────────────
    match /notifications/{userId}/items/{notifId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // ──────────────────────────────────────────────
    // BLOCK 26: Reports (moderation)
    // ──────────────────────────────────────────────
    match /reports/{reportId} {
      allow read: if isModerator();
      allow create: if isAuthenticated();
      allow update: if isModerator();
      allow delete: if isAdmin();
    }

    // ──────────────────────────────────────────────
    // BLOCK 27: Creator Shops
    // ──────────────────────────────────────────────
    match /shops/{shopId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isOwner(resource.data.creatorId) || isAdmin();
      allow delete: if isOwner(resource.data.creatorId) || isAdmin();

      match /items/{itemId} {
        allow read: if isAuthenticated();
        allow write: if isOwner(get(/databases/$(database)/documents/shops/$(shopId)).data.creatorId) || isAdmin();
      }
    }

    // ──────────────────────────────────────────────
    // BLOCK 28: Live Rooms
    // ──────────────────────────────────────────────
    match /rooms/{roomId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isOwner(resource.data.hostId) || isAdmin();
      allow delete: if isOwner(resource.data.hostId) || isAdmin();
    }

    // ──────────────────────────────────────────────
    // BLOCK 29: Feed Cache — server-only writes
    // ──────────────────────────────────────────────
    match /feed/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false;
    }

    // ──────────────────────────────────────────────
    // BLOCK 30: User Sessions
    // ──────────────────────────────────────────────
    match /sessions/{sessionId} {
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(resource.data.userId);
      allow delete: if false;
    }

    match /user_sessions/{userId}/sessions/{sessionId} {
      allow read, write: if isOwner(userId);
    }

    // ──────────────────────────────────────────────
    // BLOCK 31: System Config — admin only write
    // ──────────────────────────────────────────────
    match /config/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ──────────────────────────────────────────────
    // BLOCK 32: Analytics — admin only
    // ──────────────────────────────────────────────
    match /analytics/{document=**} {
      allow read, write: if isAdmin();
    }

    // ──────────────────────────────────────────────
    // BLOCK 33: AI Chats — Fix 5 chat history persistence
    // ──────────────────────────────────────────────
    match /ai_chats/{chatId} {
      allow read, write: if isAuthenticated();

      match /messages/{msgId} {
        allow read, write: if isAuthenticated();
      }
    }

    // ──────────────────────────────────────────────
    // BLOCK 33B: AI Session Summaries — chat context persistence
    // ──────────────────────────────────────────────
    match /ai_session_summaries/{docId} {
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    // ──────────────────────────────────────────────
    // BLOCK 34: Calendar Bookings
    // ──────────────────────────────────────────────
    match /calendarBookings/{bookingId} {
      allow read: if isAuthenticated() &&
        (resource.data.hostId == request.auth.uid ||
         resource.data.guestId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() &&
        (resource.data.hostId == request.auth.uid ||
         resource.data.guestId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ──────────────────────────────────────────────
    // BLOCK 35: Calendars (availability settings)
    // ──────────────────────────────────────────────
    match /calendars/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // ──────────────────────────────────────────────
    // BLOCK 36: Events
    // ──────────────────────────────────────────────
    match /events/{eventId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() &&
        (resource.data.earnerId == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() &&
        (resource.data.earnerId == request.auth.uid || isAdmin());
    }

    // ──────────────────────────────────────────────
    // BLOCK 37: Event Tickets
    // ──────────────────────────────────────────────
    match /eventTickets/{ticketId} {
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid ||
         resource.data.earnerId == request.auth.uid || isAdmin());
      allow write: if false; // Server-only
    }

    // ──────────────────────────────────────────────
    // BLOCK 38: Locked Media (PPV) — FIX 39
    // ──────────────────────────────────────────────
    match /locked_media/{mediaId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.creatorId == request.auth.uid;
      allow update: if isAuthenticated() &&
        (resource.data.creatorId == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() &&
        resource.data.creatorId == request.auth.uid;
    }

    // ──────────────────────────────────────────────
    // BLOCK 39: Media Purchases — FIX 39
    // ──────────────────────────────────────────────
    match /media_purchases/{purchaseId} {
      allow read: if isAuthenticated() &&
        (resource.data.buyerId == request.auth.uid ||
         resource.data.creatorId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() &&
        request.resource.data.buyerId == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    // ──────────────────────────────────────────────
    // FIX 40: Video Calls — WebRTC signaling
    // ──────────────────────────────────────────────
    match /calls/{callId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if false;

      match /candidates/{peerId}/ice/{candidateId} {
        allow read, write: if isAuthenticated();
      }
    }

    // ──────────────────────────────────────────────
    // FIX 41: Live Sessions — real-time chat with gift economy
    // ──────────────────────────────────────────────
    match /live_sessions/{sessionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if false;

      match /messages/{msgId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
      }
    }

    // ──────────────────────────────────────────────
    // FIX 42: Subscriptions — token-based monthly recurring
    // ──────────────────────────────────────────────
    match /subscriptions/{subId} {
      allow read: if isAuthenticated() &&
        (resource.data.subscriberId == request.auth.uid ||
         resource.data.creatorId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() &&
        (resource.data.subscriberId == request.auth.uid || isAdmin());
      allow delete: if false;
    }

    // ──────────────────────────────────────────────
    // FIX 73: Matches — server-only writes (created by likeUserV1)
    // ──────────────────────────────────────────────
    match /matches/{matchId} {
      allow read: if isAuthenticated() &&
        (resource.data.userId1 == request.auth.uid ||
         resource.data.userId2 == request.auth.uid);
      allow write: if false; // Server-only (created by likeUserV1)
    }

    // ──────────────────────────────────────────────
    // FIX 73: Daily Free Chats — user's own subcollection
    // ──────────────────────────────────────────────
    match /users/{userId}/daily_free_chats/{dateKey} {
      allow read, write: if isOwner(userId);
    }

    // ──────────────────────────────────────────────
    // FIX 74E: Ad Campaigns — advertising system
    // Revenue: 100% Avalo
    // ──────────────────────────────────────────────
    match /ad_campaigns/{campaignId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() &&
        (resource.data.advertiserId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // ──────────────────────────────────────────────
    // FIX 81: Support Tickets
    // ──────────────────────────────────────────────
    match /support_tickets/{ticketId} {
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isModerator());
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isModerator());
      allow delete: if isAdmin();
    }

    // ──────────────────────────────────────────────
    // FIX 82: Referrals
    // ──────────────────────────────────────────────
    match /referrals/{referralId} {
      allow read: if isAuthenticated() &&
        (resource.data.referrerId == request.auth.uid ||
         resource.data.referredId == request.auth.uid ||
         isAdmin());
      allow create: if isAuthenticated();
      allow update: if false; // Server-only updates
      allow delete: if false;
    }

    // ──────────────────────────────────────────────
    // FIX 92/138: Drops — limited-time offers
    // ──────────────────────────────────────────────
    match /drops/{dropId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && resource.data.creatorId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.creatorId == request.auth.uid;
    }

    // ──────────────────────────────────────────────
    // FIX 138: Active Lives — live streaming presence
    // ──────────────────────────────────────────────
    match /active_lives/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // ──────────────────────────────────────────────
    // FIX 138: Post Likes — social interactions
    // ──────────────────────────────────────────────
    match /post_likes/{postId}/users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // ──────────────────────────────────────────────
    // FIX 138: Post Comments — social interactions
    // ──────────────────────────────────────────────
    match /post_comments/{postId}/comments/{commentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow delete: if isAuthenticated() &&
        (resource.data.authorId == request.auth.uid || isModerator());
    }

    // ──────────────────────────────────────────────
    // BLOCK pending_transactions — welcome bonus and server queue
    // ──────────────────────────────────────────────
    match /pending_transactions/{docId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow update, delete: if false;
    }

    // ──────────────────────────────────────────────
    // CATCH-ALL — Deny all other access
    // Must be LAST. Any collection not matched above is denied.
    // ──────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }

  }
}

