{
  "firestore": {
    "rules": "infrastructure/firebase/firestore.rules",
    "indexes": "infrastructure/firebase/firestore.indexes.json"
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs20"
  },
  "hosting": [
    {
      "target": "app",
      "public": "public",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "/api/**",
          "function": "app"
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "cleanUrls": true
    },
    {
      "target": "web",
      "public": "app-web/out",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "/api/**",
          "function": "nextjsFunc"
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "cleanUrls": true
    },
    {
      "target": "landing",
      "public": "web-landing/dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "cleanUrls": true
    }
  ],
  "storage": {
    "rules": "infrastructure/firebase/storage.rules"
  },
  "emulators": {
    "singleProjectMode": true,
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "functions": {
      "port": 5001
    },
    "hosting": {
      "port": 5000
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": true,
      "port": 4000
    }
  },
  "apphosting": [
    {
      "backendId": "avalo-web-staging",
      "rootDir": "app-web",
      "ignore": [
        "node_modules",
        ".git",
        ".next",
        ".apphosting",
        "out",
        "coverage",
        "playwright-report",
        "test-results",
        ".turbo",
        ".cache",
        "docs",
        "tests",
        "*.md",
        "*.bak",
        "*.tmp",
        ".env.local",
        ".env.*.local",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "functions",
        "*.tsbuildinfo"
      ],
      "alwaysDeployFromSource": true
    }
  ]
}
